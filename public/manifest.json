{
  "manifest_version": 3,
  "name": "ContextBridge \u00b7 Read, notice, understand",
  "description": "Explore an expression in context, save the encounter, and revisit it later. Connects to your ContextBridge account.",
  "version": "0.1.2",
  "minimum_chrome_version": "121",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Explore with ContextBridge",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "sidepanel.html#settings",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "key": "",
  "externally_connectable": {
    "matches": [
      "https://contextbridge-newpoluton.vercel.app/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
